{
  "version": "1.0.0",
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "active": true,
    "longDescription": "Custom dual physical adapter routing client based on Clash Verge Rev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ],
    "resources": [
      "resources"
    ],
    "publisher": "Clash Verge Dual NIC",
    "externalBin": [
      "sidecar/verge-mihomo-dualnic",
      "sidecar/verge-mihomo-dualnic-alpha"
    ],
    "copyright": "GNU General Public License v3.0",
    "category": "DeveloperTool",
    "shortDescription": "Dual physical network adapter routing with Mihomo",
    "createUpdaterArtifacts": false,
    "licenseFile": "../LICENSE"
  },
  "build": {
    "beforeBuildCommand": "node scripts/dualnic/web-build.mjs",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run web:dev",
    "devUrl": "http://localhost:3000/",
    "removeUnusedCommands": true
  },
  "productName": "Clash Verge Dual NIC",
  "identifier": "io.github.clash-verge-dualnic",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "clash-verge-dualnic"
        ]
      }
    }
  },
  "app": {
    "security": {
      "capabilities": [
        "desktop-capability",
        "migrated"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  },
  "mainBinaryName": "clash-verge-dualnic"
}
